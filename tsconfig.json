{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "worker-configuration.d.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
